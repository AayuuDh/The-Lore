# ============================================================================
# ui/.env.example  -  Template for the frontend's environment variables.
# ----------------------------------------------------------------------------
# Copy this file to ui/.env and fill in the real values. The real .env is
# gitignored so secrets never get committed; this template IS committed so
# teammates know which variables to set.
#
# After creating/editing ui/.env you MUST restart the dev server: Vite only
# reads .env once, at startup.
#
# Both GUIDs come from the Entra app registration's "Overview" page.
# ============================================================================

# Application (client) ID: identifies our app to Microsoft.
VITE_MSAL_CLIENT_ID=your-application-client-id-here

# Directory (tenant) ID: scopes login to our organization's directory.
VITE_MSAL_TENANT_ID=your-directory-tenant-id-here
