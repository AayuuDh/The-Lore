# ============================================================================
# ui/.env.example  -  Template for the frontend's environment variables.
# ----------------------------------------------------------------------------
# Copy this file to ui/.env to override the local backend URL.
#
# After creating/editing ui/.env you MUST restart the dev server: Vite only
# reads .env once, at startup.
#
# ============================================================================

VITE_API_BASE_URL=http://localhost:8000
