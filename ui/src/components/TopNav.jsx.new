import React, { useEffect, useRef, useState } from "react";
import {
  ThreeBarsIcon,
  SearchIcon,
  PersonIcon,
  FlameIcon,
  GearIcon,
  StarIcon,
  SignOutIcon,
} from "@primer/octicons-react";
import logo from "../assets/logo light.png";
import "./TopNav.css";

// The top bar. The avatar on the right opens a GitHub-style account menu with
// links to the profile, settings, favorites and sign out. Only "Your profile"
// and "Sign out" are wired up for now; the others are placeholders.
function TopNav({
  onMenuClick,
  currentPage,
  streak,
  profile,
  onOpenProfile,
  onOpenFavorites,
  onOpenSettings,
  onSignOut,
}) {
  const [menuOpen, setMenuOpen] = useState(false);
  const menuRef = useRef(null);

  const username = profile?.username;
  const fullName = [profile?.first_name, profile?.last_name]
    .filter(Boolean)
    .join(" ");
  const displayName = fullName || username || "Your account";
  const avatarSrc = profile?.avatar;

  // Close the menu when clicking anywhere outside it or pressing Escape.
  useEffect(() => {
    if (!menuOpen) return;
    function handlePointer(e) {
      if (menuRef.current && !menuRef.current.contains(e.target)) {
        setMenuOpen(false);
      }
    }
    function handleKey(e) {
      if (e.key === "Escape") setMenuOpen(false);
    }
    document.addEventListener("mousedown", handlePointer);
    document.addEventListener("keydown", handleKey);
    return () => {
      document.removeEventListener("mousedown", handlePointer);
      document.removeEventListener("keydown", handleKey);
    };
  }, [menuOpen]);

  const runAndClose = (fn) => () => {
    setMenuOpen(false);
    fn?.();
  };

  const avatarInner = avatarSrc ? (
    <img className="topnav__avatar-img" src={avatarSrc} alt="Profile" />
  ) : (
    <PersonIcon size={20} />
  );

  return (
    <header className="topnav">
      {/* Left group */}

      <div className="topnav__left">
        <button
          className="topnav__hamburger"
          onClick={onMenuClick}
          aria-label="Open sidebar"
        >
          <ThreeBarsIcon size={16} />
        </button>

        <img
          className="topnav__logo"
          src={logo}
          width="28"
          height="40"
          alt="Logo"
        />

        <span className="topnav__separator">/</span>
        <span className="topnav__page-name">{currentPage}</span>
      </div>

      {/* Center — Search */}
      <div className="topnav__center">
        <div className="topnav__search">
          <SearchIcon size={16} className="topnav__search-icon" />
          <input
            type="text"
            className="topnav__search-input"
            placeholder="Type / to search"
          />
          <span className="topnav__search-shortcut">/</span>
        </div>
      </div>

      {/* Right group */}
      <div className="topnav__right">
        {streak && streak.current > 0 && (
          <div
            className="topnav__streak"
            title={`${streak.current}-day streak \u2014 best: ${streak.longest}`}
            aria-label={`${streak.current} day streak`}
          >
            <FlameIcon size={16} />
            <span>{streak.current}</span>
          </div>
        )}

        <div className="topnav__account" ref={menuRef}>
          <button
            className="topnav__avatar"
            aria-label="Open account menu"
            aria-haspopup="menu"
            aria-expanded={menuOpen}
            onClick={() => setMenuOpen((open) => !open)}
            title={username ? `Signed in as ${username}` : "Account"}
          >
            {username && <span className="topnav__username">{username}</span>}
            <span className="topnav__avatar-circle">{avatarInner}</span>
          </button>

          {menuOpen && (
            <div className="topnav__menu" role="menu">
              <div className="topnav__menu-header">
                <span className="topnav__menu-avatar">{avatarInner}</span>
                <div className="topnav__menu-identity">
                  <span className="topnav__menu-name">{displayName}</span>
                  {username && (
                    <span className="topnav__menu-handle">@{username}</span>
                  )}
                </div>
              </div>

              <div className="topnav__menu-divider" />

              <button
                className="topnav__menu-item"
                role="menuitem"
                onClick={runAndClose(onOpenProfile)}
              >
                <PersonIcon size={16} />
                <span>Your profile</span>
              </button>
              <button
                className="topnav__menu-item"
                role="menuitem"
                onClick={runAndClose(onOpenSettings)}
              >
                <GearIcon size={16} />
                <span>Settings</span>
              </button>
              <button
                className="topnav__menu-item"
                role="menuitem"
                onClick={runAndClose(onOpenFavorites)}
              >
                <StarIcon size={16} />
                <span>Favorites</span>
              </button>

              <div className="topnav__menu-divider" />

              <button
                className="topnav__menu-item topnav__menu-item--danger"
                role="menuitem"
                onClick={runAndClose(onSignOut)}
              >
                <SignOutIcon size={16} />
                <span>Sign out</span>
              </button>
            </div>
          )}
        </div>
      </div>
    </header>
  );
}

export default TopNav;
