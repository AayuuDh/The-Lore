# ============================================================================
# matching/.env  -  Backend environment variables (all OPTIONAL for local dev).
# ----------------------------------------------------------------------------
# Copy this file to matching/.env and fill in only what you need. The backend
# runs WITHOUT any of these:
#   - No COSMOS_* set    -> skills are read/written from data/skills/*.md files.
#   - No AZURE_OPENAI_*  -> the AI features (discovery guide, skill drafting,
#                           skill editor) fall back to a local Ollama model.
# So a fresh clone starts with zero cloud setup. Fill these in only to switch on
# the cloud-backed features. (matching/.env is gitignored — secrets never commit.)
# ============================================================================

# --- Azure OpenAI: powers the discovery guide, drafting, and editor -----------
# Set ENDPOINT + DEPLOYMENT + API_KEY to use Azure. If any is missing, the app
# uses the local Ollama model below instead.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_API_KEY=

# --- Local Ollama fallback (used when Azure OpenAI isn't set) ------------------
# Requires Ollama running locally with the model pulled: `ollama pull llama3.2:3b`.
OLLAMA_MODEL=llama3.2:3b

# --- Azure Cosmos DB: the shared skills store (else local markdown files) ------
# Set COSMOS_KEY (and endpoint) to use Cosmos instead of data/skills/*.md.
COSMOS_ENDPOINT=
COSMOS_KEY=
COSMOS_DATABASE=lore
COSMOS_CONTAINER=skills
COSMOS_USERS_CONTAINER=users

# --- CORS ---------------------------------------------------------------------
# Comma-separated browser origins allowed to call this API. Leave blank to use
# the built-in defaults (the Static Web App + the Vite dev server). Set this if
# a custom domain or PR preview environment is added.
ALLOWED_ORIGINS=

# --- Rate limiting (ratelimit.py) ---------------------------------------------
# Applies ONLY to the four endpoints that call Azure OpenAI, in the form
# "requests/seconds" per caller. Set to 0 to disable. In-process, so it does not
# coordinate across App Service instances.
RATE_LIMIT_LLM=20/60
