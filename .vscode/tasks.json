{
  // VS Code tasks run project commands from a menu: Terminal > Run Task...
  //
  // FIRST TIME on a machine: run "Setup (run once)" — it creates an isolated
  // Python virtual environment in .venv/ (nothing installed globally) and
  // installs the backend and frontend packages.
  //
  // DAY TO DAY: run "Start Dev" — it launches the backend and frontend together,
  // each in its own terminal panel.
  "version": "2.0.0",
  "tasks": [
    {
      // >>> RUN THIS ONE <<<  Starts backend + frontend together.
      "label": "Start Dev",
      "dependsOn": ["Backend", "Frontend"],
      "dependsOrder": "parallel",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      // FastAPI backend, run from matching/ using the project's venv Python
      // (.venv) rather than a global interpreter.
      "label": "Backend",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python -m uvicorn main:app --reload",
      "windows": {
        "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe -m uvicorn main:app --reload"
      },
      "osx": {
        "command": "${workspaceFolder}/.venv/bin/python -m uvicorn main:app --reload"
      },
      "linux": {
        "command": "${workspaceFolder}/.venv/bin/python -m uvicorn main:app --reload"
      },
      "options": {
        "cwd": "${workspaceFolder}/matching"
      },
      "isBackground": true,
      "presentation": {
        "group": "dev-servers",
        "panel": "dedicated",
        "reveal": "always",
        "focus": false,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      // Vite frontend, run from ui/.
      "label": "Frontend",
      "type": "shell",
      "command": "npm run dev",
      "windows": {
        // On Windows call npm.cmd (plain "npm" can fail inside tasks).
        "command": "npm.cmd run dev"
      },
      "osx": {
        "command": "npm run dev"
      },
      "linux": {
        "command": "npm run dev"
      },
      "options": {
        "cwd": "${workspaceFolder}/ui"
      },
      "isBackground": true,
      "presentation": {
        "group": "dev-servers",
        "panel": "dedicated",
        "reveal": "always",
        "focus": false,
        "clear": true
      },
      "problemMatcher": []
    },

    // --- One-time setup -----------------------------------------------------
    {
      // Run once per machine. Runs the two installs below, in order.
      "label": "Setup (run once)",
      "dependsOn": ["Install backend deps", "Install frontend deps"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      // Creates the isolated environment in .venv/ (safe to re-run; reuses an
      // existing .venv). Keeps Python packages out of the global interpreter.
      "label": "Create Python venv",
      "type": "shell",
      "command": "python3 -m venv .venv",
      "windows": { "command": "py -m venv .venv" },
      "osx": { "command": "python3 -m venv .venv" },
      "linux": { "command": "python3 -m venv .venv" },
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": []
    },
    {
      // Installs backend packages into .venv (never the global interpreter).
      "label": "Install backend deps",
      "type": "shell",
      "dependsOn": ["Create Python venv"],
      "dependsOrder": "sequence",
      "command": "${workspaceFolder}/.venv/bin/python -m pip install -r matching/requirements.txt",
      "windows": {
        "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe -m pip install -r matching\\requirements.txt"
      },
      "osx": {
        "command": "${workspaceFolder}/.venv/bin/python -m pip install -r matching/requirements.txt"
      },
      "linux": {
        "command": "${workspaceFolder}/.venv/bin/python -m pip install -r matching/requirements.txt"
      },
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      // Installs frontend packages into ui/node_modules.
      "label": "Install frontend deps",
      "type": "shell",
      "command": "npm install",
      "windows": { "command": "npm.cmd install" },
      "osx": { "command": "npm install" },
      "linux": { "command": "npm install" },
      "options": { "cwd": "${workspaceFolder}/ui" },
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    }
  ]
}
